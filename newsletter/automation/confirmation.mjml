<mjml>
	<mj-head>
		<mj-style>
			body {
				background-image: url('./assets/halftone/halftone_1x.webp');
				background-color: #ff007b;
				background-size: cover;
				background-repeat: no-repeat;
				background-position: top center;
			}
		</mj-style>
		<mj-font name="Rubik Spray Paint" href="https://fonts.googleapis.com/css2?family=Rubik+Spray+Paint" />
	</mj-head>

	<mj-body>
		<!-- Header -->
		<mj-section>
			<mj-column width="100%">
				<mj-text align="center" font-size="12px" color="#FFD4E9">View this mail in your browser</mj-text>
			</mj-column>
		</mj-section>
		<mj-section>
			<mj-column width="300px">
				<mj-text font-family="Rubik Spray Paint"> Hello World! </mj-text>
			</mj-column>
			<mj-column width="300px">
				<mj-text> This is column 2 </mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
