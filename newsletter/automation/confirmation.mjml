<mjml>
	<mj-include path="../components/head.mjml" />
	<mj-body>
		<mj-include path="../components/header.mjml" />
		<mj-section gutter="12px">
			<mj-column width="437px">
				<mj-table padding="0">
					<!-- Top Row-->
					<tr>
						<td width="24" height="24" style="width: 24px; height: 24px; line-height: 0; font-size: 0; padding: 0">
							<img
								src="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b630ea771d152c42b46.jpg"
								width="24"
								height="24"
								alt=""
								style="display: block"
							/>
						</td>
						<td
							height="24"
							background="url(https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63bae7eb6823a6a283.jpg)"
							style="
								height: 24px;
								background: url('https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63bae7eb6823a6a283.jpg') repeat-x top /
									auto 24px;
							"
						></td>
						<td width="24" height="24" style="width: 24px; height: 24px; line-height: 0; font-size: 0">
							<img
								src="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b639851b2d07e18524d.jpg"
								width="24"
								height="24"
								alt=""
								style="display: block"
							/>
						</td>
					</tr>
					<!-- Content Row -->
					<tr>
						<td
							width="24"
							background="url(https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63e797c6d6b6385757.jpg)"
							style="
								width: 24px;
								background: url('https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63e797c6d6b6385757.jpg') repeat-y right
									top / 24px auto;
							"
						></td>
						<td
							bgcolor="#FFD4E9"
							style="
								background-color: #ffd4e9;
								padding: 8px;
								vertical-align: top;
								font-family: Arial, sans-serif;
								font-size: 14px;
								line-height: 1.3;
								padding: 0;
							"
						>
							<h2
								style="
									font-size: 24px;
									line-height: 110%;
									color: #ff007b;
									text-align: left;
									font-family: 'Gore', Impact;
									padding-bottom: 16px;
									margin: 0;
								"
							>
								Welcome to Hinkart Tattoo
							</h2>
							<p style="font-size: 16px; line-height: 130%; text-align: left; padding-bottom: 16px">Please confirm your email address.</p>
							<a href="{{ doubleoptin }}" target="_blank" title="Confirm my email address">
								<img
									src="https://img.mailinblue.com/10922970/images/content_library/original/6aeafafc6dbcaafc6f32371d.png"
									width="145px"
									alt="Confirm my email address"
								/>
							</a>
						</td>
						<td
							width="24"
							background="url(https://img.mailinblue.com/10922970/images/content_library/original/6aea6b630ea771d152c42b47.jpg)"
							style="
								width: 24px;
								background: url('https://img.mailinblue.com/10922970/images/content_library/original/6aea6b630ea771d152c42b47.jpg') repeat-y right
									top / 24px auto;
							"
						></td>
					</tr>
					<!-- Bottom Row -->
					<tr>
						<td width="24" height="24" style="width: 24px; height: 24px; line-height: 0; font-size: 0">
							<img
								src="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63e797c6d6b6385756.jpg"
								width="24"
								height="24"
								alt=""
								style="display: block"
							/>
						</td>
						<td
							height="24"
							background="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b636dbcaafc6f3223bc.jpg"
							style="
								height: 24px;
								background: url('https://img.mailinblue.com/10922970/images/content_library/original/6aea6b636dbcaafc6f3223bc.jpg') repeat-x bottom /
									auto 24px;
							"
						></td>
						<td width="24" height="24" style="width: 24px; height: 24px; line-height: 0; font-size: 0">
							<img
								src="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63bae7eb6823a6a282.jpg"
								width="24"
								height="24"
								alt=""
								style="display: block"
							/>
						</td>
					</tr>
				</mj-table>
				<mj-spacer height="12px" />
				<mj-table padding="0">
					<!-- Top Row -->
					<tr>
						<td width="24" height="24" style="width: 24px; height: 24px; line-height: 0; font-size: 0">
							<img
								src="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b630ea771d152c42b46.jpg"
								width="24"
								height="24"
								alt=""
								style="display: block"
							/>
						</td>
						<td
							height="24"
							background="url(https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63bae7eb6823a6a283.jpg)"
							style="
								height: 24px;
								background: url('https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63bae7eb6823a6a283.jpg') repeat-x top /
									auto 24px;
							"
						></td>
						<td width="24" height="24" style="width: 24px; height: 24px; line-height: 0; font-size: 0">
							<img
								src="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b639851b2d07e18524d.jpg"
								width="24"
								height="24"
								alt=""
								style="display: block"
							/>
						</td>
					</tr>
					<!-- Content Row -->
					<tr>
						<td
							width="24"
							background="url(https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63e797c6d6b6385757.jpg)"
							style="
								width: 24px;
								background: url('https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63e797c6d6b6385757.jpg') repeat-y right
									top / 24px auto;
							"
						></td>
						<td
							bgcolor="#FFD4E9"
							style="
								background-color: #ffd4e9;
								padding: 8px;
								vertical-align: top;
								font-family: Arial, sans-serif;
								font-size: 14px;
								line-height: 1.3;
								padding: 0;
							"
						>
							<h2
								style="
									margin: 0 0 16px;
									font-family: Gore, Impact, sans-serif;
									font-size: 24px;
									line-height: 1.1;
									color: #ff007b;
									font-weight: normal;
								"
							>
								100% No Spam Guaranteed!
							</h2>
							<p style="margin: 0">
								Whitelist <a href="mailto:newsletter@hinkart.nl" target="_blank" style="">newsletter@hinkart.nl</a> to make sure that you receive our
								maills into your inbox.
							</p>
						</td>
						<td
							width="24"
							background="url(https://img.mailinblue.com/10922970/images/content_library/original/6aea6b630ea771d152c42b47.jpg)"
							style="
								width: 24px;
								background: url('https://img.mailinblue.com/10922970/images/content_library/original/6aea6b630ea771d152c42b47.jpg') repeat-y right
									top / 24px auto;
							"
						></td>
					</tr>
					<!-- Bottom Row -->
					<tr>
						<td width="24" height="24" style="width: 24px; height: 24px; line-height: 0; font-size: 0">
							<img
								src="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63e797c6d6b6385756.jpg"
								width="24"
								height="24"
								alt=""
								style="display: block"
							/>
						</td>
						<td
							height="24"
							background="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b636dbcaafc6f3223bc.jpg"
							style="
								height: 24px;
								background: url('https://img.mailinblue.com/10922970/images/content_library/original/6aea6b636dbcaafc6f3223bc.jpg') repeat-x bottom /
									auto 24px;
							"
						></td>
						<td width="24" height="24" style="width: 24px; height: 24px; line-height: 0; font-size: 0">
							<img
								src="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63bae7eb6823a6a282.jpg"
								width="24"
								height="24"
								alt=""
								style="display: block"
							/>
						</td>
					</tr>
				</mj-table>
			</mj-column>
			<mj-column width="163px" vertical-align="bottom">
				<mj-image
					src="https://img.mailinblue.com/10922970/images/content_library/original/6aeafc19526b8dd402527d91.png"
					alt="Cat Illustration by Hinkart Tattoo"
					width="163px"
				/>
			</mj-column>
		</mj-section>
		<!-- Social and No Subsciber Statement -->
		<mj-section padding="0" padding-top="12px" gutter="12px">
			<mj-column width="300px" padding="0"><mj-include path="../components/follow.mjml" /> </mj-column>
			<mj-column width="300px">
				<mj-table padding="0">
					<tr>
						<td width="24" height="24" style="width: 24px; height: 24px; line-height: 0; font-size: 0">
							<img
								src="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b630ea771d152c42b46.jpg"
								width="24"
								height="24"
								alt=""
								style="display: block"
							/>
						</td>
						<td
							height="24"
							background="url(https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63bae7eb6823a6a283.jpg)"
							style="
								height: 24px;
								background: url('https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63bae7eb6823a6a283.jpg') repeat-x top /
									auto 24px;
							"
						></td>
						<td width="24" height="24" style="width: 24px; height: 24px; line-height: 0; font-size: 0">
							<img
								src="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b639851b2d07e18524d.jpg"
								width="24"
								height="24"
								alt=""
								style="display: block"
							/>
						</td>
					</tr>
					<tr>
						<td
							width="24"
							background="url(https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63e797c6d6b6385757.jpg)"
							style="
								width: 24px;
								background: url('https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63e797c6d6b6385757.jpg') repeat-y right
									top / 24px auto;
							"
						></td>
						<td
							bgcolor="#FFD4E9"
							style="
								background-color: #ffd4e9;
								padding: 8px;
								vertical-align: top;
								font-family: Arial, sans-serif;
								font-size: 14px;
								line-height: 1.3;
								padding: 0;
							"
						>
							<p style="margin: 0 0 10px 0; font-size: 10px; color: #7f003d">
								You’re receiving this message because you’ve signed up to receive our Newsletter at
								<a href="https://hinkart.nl" target="_blank" style="text-decoration: underline">hinkart.nl.</a>
							</p>
							<p style="margin: 0; font-size: 10px; color: #7f003d">
								If you didn’t sign up just ignore this message and you won’t hear from us again.
							</p>
						</td>
						<td
							width="24"
							background="url(https://img.mailinblue.com/10922970/images/content_library/original/6aea6b630ea771d152c42b47.jpg)"
							style="
								width: 24px;
								background: url('https://img.mailinblue.com/10922970/images/content_library/original/6aea6b630ea771d152c42b47.jpg') repeat-y right
									top / 24px auto;
							"
						></td>
					</tr>
					<tr>
						<td width="24" height="24" style="width: 24px; height: 24px; line-height: 0; font-size: 0">
							<img
								src="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63e797c6d6b6385756.jpg"
								width="24"
								height="24"
								alt=""
								style="display: block"
							/>
						</td>
						<td
							height="24"
							background="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b636dbcaafc6f3223bc.jpg"
							style="
								height: 24px;
								background: url('https://img.mailinblue.com/10922970/images/content_library/original/6aea6b636dbcaafc6f3223bc.jpg') repeat-x bottom /
									auto 24px;
							"
						></td>
						<td width="24" height="24" style="width: 24px; height: 24px; line-height: 0; font-size: 0">
							<img
								src="https://img.mailinblue.com/10922970/images/content_library/original/6aea6b63bae7eb6823a6a282.jpg"
								width="24"
								height="24"
								alt=""
								style="display: block"
							/>
						</td>
					</tr>
				</mj-table>
			</mj-column>
		</mj-section>
		<mj-include path="../components/footer.mjml" />
		<!-- <mj-section>
			<mj-column><mj-image src="../automation/assets/confirmation/Image Container@2x.png" alt="Cat Tattoo by Hinkart" width="163px" /></mj-column>
		</mj-section> -->
	</mj-body>
</mjml>
