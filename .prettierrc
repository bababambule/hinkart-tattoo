{
	"printWidth": 150,
	"tabWidth": 2,
	"useTabs": true,
	"semi": true,
	"singleQuote": true,
	"trailingComma": "all",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
  	"overrides": [{ "files": "*.astro", "options": { "parser": "astro" } }],
	"tailwindStylesheet": "./src/styles/global.css"
}
