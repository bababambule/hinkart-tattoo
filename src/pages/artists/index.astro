---
import Layout from '../../layouts/LayoutNew.astro';
import ArtistSlide from '../../components/ArtistSlide.astro';
import PaginationButton from '../../components/PaginationButton.astro';

const allArtists = Object.values(import.meta.glob('./*.md', { eager: true }));
const artistSorted = allArtists.sort((a, b) => a.frontmatter.order - b.frontmatter.order);
---

<Layout>
	<div class="embla h-full flex-1 relative flex flex-col justify-stretch">
		<div class="embla__viewport overflow-hidden h-full flex-1 flex flex-col justify-stretch">
			<div class="embla__container flex-1 h-full flex flex-row justify-stretch items-stretch">
				{artistSorted.map((post: any, index: number) => (
					<ArtistSlide name={post.frontmatter.name} index={index} slug={post.url} video={post.frontmatter.video} />
				))}
			</div>
			<div class="flex justify-between w-full absolute bottom-1/10 pointer-events-none">
				<PaginationButton label="Prev" type="prev" />
				<PaginationButton label="Next" type="next" />
			</div>
		</div>
	</div>
</Layout>

<style>
	.embla {
		--slide-spacing: 0rem;
	}

	.embla__container {
		touch-action: pan-y pinch-zoom;
		margin-left: calc(var(--slide-spacing) * -1);
	}
</style>

<script src="../../scripts/artists.ts"></script>
