---
import Layout from '../layouts/Layout.astro';
import Heading from '../components/Heading.astro';
import KanjiTitle from '../components/KanjiTitle.astro';
import RadioButton from '../components/form/RadioButton.astro';
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';
import giftcardImage from '../assets/images/giftcard_10x15_front.webp';
---

<Layout>
	<div class="flex flex-col max-w-dvw overflow-x-clip">
		<div class="bg-daintree-300 mx-auto h-90 w-[calc(100%-2rem)] border-l-4 border-r-4 border-b-4 border-daintree-1000">
			<Image src={giftcardImage} alt="" class:list={['size-full object-cover']} />
		</div>
		<div class="-rotate-3 px-2 -mt-8">
			<Heading title="Giftcards" size="text-5xl xl:text-9xl" yPos={50} />
			<KanjiTitle title="ギフトカード" size="text-3xl xl:text-7xl" classes="-mb-8 -mt-24 mr-2 text-right" />
		</div>
		<div class="flex flex-col gap-8">
			<div class="text-daintree-100 flex-1">
				<p class="text-xl leading-normal mb-4 bg-daintree-200 border-4 border-l-0 border-daintree-1000 text-daintree-900 p-4 pt-8 max-w-2/3">
					Want to give someone their first tattoo, help fund their next piece, or let them choose their own artist? Gift cards work for all of it.
				</p>
				<p class="mb-4 leading-relaxed max-w-[75ch] text-daintree-900 bg-daintree-200 p-4 mx-4">
					Pick an amount between €20 and €200—whatever makes sense for what you're gifting. The recipient can use it toward a session with any of our
					artists, and if they don't spend it all at once, the balance stays in our system for next time.
				</p>
				<!-- <div class="h-full w-1/5 invisible float-left shape-outside"></div> -->
			</div>
			<div class="w-full relative">
				<svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" class="absolute top-0 left-0 overflow-visible" preserveAspectRatio="none">
					<filter id="displacementFilter">
						<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="4" result="turbulence"></feTurbulence>
						<feDisplacementMap in2="turbulence" in="SourceGraphic" scale="12" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
					</filter>
					<style>
						:root {
							--pos-x: -4px;
							--pos-y: 0px;
							--rad-x: var(--radius-sm);
							--rad-y: var(--radius-sm);
							--width: calc(100% - 16px);
							--height: calc(100% - 16px);
							--transform: skewX(-2deg);
							--fill: var(--color-daintree-200);
							--stroke: var(--color-daintree-1000);
							--stroke-width: 8px;
						}
						@media screen and (min-width: var(--breakpoint-xl)) {
							:root {
								--pos-x: 4px;
								--pos-y: 4px;
								--rad-x: 8px;
								--rad-y: 8px;
								--width: calc(100% - 16px);
								--height: calc(100% - 16px);
								--transform: skewX(-4deg);
								--fill: var(--color-daintree-100);
								--stroke: var(--color-daintree-1000);
								--stroke-width: 8px;
							}
						}
						rect {
							x: var(--pos-x);
							y: var(--pos-y);
							rx: var(--rad-x);
							ry: var(--rad-y);
							width: var(--width);
							height: var(--height);
							transform: var(--transform);
							fill: var(--fill);
							stroke: var(--stroke);
							stroke-width: var(--stroke-width);
							stroke-linejoin: round;
							paint-order: stroke;
						}
					</style>
					<rect filter="url(#displacementFilter)"></rect>
				</svg>
				<div class="relative z-10 w-full h-full py-8 px-4 overflow-x-clip">
					<form
						class="z-10 h-full relative flex flex-col gap-4 justify-evenly"
						action="https://webhooktest.net/webhook/01a0ede0-54f9-714d-b900-d3eb2d6f6d48"
					>
						<div class="flex flex-row flex-wrap justify-start">
							<div class="flex flex-row gap-0">
								<RadioButton name="voucher" id="voucher20" value="20" label="20€" />
								<RadioButton name="voucher" id="voucher50" value="50" label="50€" />
								<RadioButton name="voucher" id="voucher100" value="100" label="100€" />
								<RadioButton name="voucher" id="voucher200" value="200" label="200€" />
							</div>
							<div class="flex flex-row justify-between w-full pr-6">
								<Button icon="Map" href={null} label="Checkout" kanji="金額" />
								<p>Payment Options</p>
							</div>
						</div>
						<p class="text-xs text-daintree-600 max-w-[60ch] pr-6">
							No physical card gets mailed out. Once you buy it, the gift card info is stored in our system and you'll get a printable version you can
							give however you want—stick it in a card, email it, wrap it up, whatever works. They just bring it up when they book. Giftcards are
							non-refundable.
						</p>
					</form>
				</div>
			</div>
		</div>
	</div>
	<!-- <div class="flex flex-col h-full">
		<div class="flex flex-row flex-1">
			<div class="flex-1 flex justify-end items-center pr-4">
				<Image src={giftcardImage} alt="Get your Giftcard" class="h-3/4 w-3/4 z-20" />
			</div>
			<div class="flex-1 flex flex-col pr-16 xl:pt-24">
				<div class="-ml-32 z-30">
					<Heading title="Giftcards" />
					<KanjiTitle title="ギフトカード" />
				</div>
			</div>
		</div>
	</div> -->

	<style>
		.shape-outside {
			shape-outside: polygon(0% 0%, 100% 0%, 80% 100%, 0% 100%);
		}
	</style>
</Layout>
