---
import Layout from '../layouts/Layout.astro';
import TwoColumLayout from '../components/layout/TwoColumLayout.astro';
import SectionTitleImage from '../components/sections/SectionTitleImage.astro';
import Heading from '../components/Heading.astro';
import KanjiTitle from '../components/KanjiTitle.astro';
import RadioButton from '../components/form/RadioButton.astro';
import Button from '../components/ui/Button.astro';
import { Image } from 'astro:assets';
import giftcardImage from '../assets/images/giftcard_10x15_front.webp';
---

<Layout>
	<TwoColumLayout>
		<SectionTitleImage slot="left" img={giftcardImage} alt="Giftcards for Hinkart Tattoo" />
		<div class="flex max-w-dvw flex-col overflow-x-clip lg:h-full lg:justify-start lg:bg-red-400" slot="right">
			<div class="-mt-8 flex -rotate-3 px-2 lg:mt-0 lg:flex-col">
				<Heading title="Giftcards" size="text-5xl xl:text-9xl" yPos={105} />
				<KanjiTitle title="ギフトカード" size="text-3xl xl:text-7xl" classes="-mb-8 -mt-24 mr-2 text-right" />
			</div>
			<div class="flex flex-col gap-8">
				<div class="flex-1 text-daintree-100">
					<p class="mb-4 max-w-2/3 border-4 border-l-0 border-daintree-1000 bg-daintree-200 p-4 pt-8 text-xl leading-normal text-daintree-900">
						Want to give someone their first tattoo, help fund their next piece, or let them choose their own artist? Gift cards work for all of it.
					</p>
					<p class="mx-4 mb-4 max-w-[75ch] bg-daintree-200 p-4 leading-relaxed text-daintree-900">
						Pick an amount between €20 and €200—whatever makes sense for what you're gifting. The recipient can use it toward a session with any of
						our artists, and if they don't spend it all at once, the balance stays in our system for next time.
					</p>
					<!-- <div class="h-full w-1/5 invisible float-left shape-outside"></div> -->
				</div>
				<div class="relative w-full">
					<svg
						width="100%"
						height="100%"
						xmlns="http://www.w3.org/2000/svg"
						class="absolute top-0 left-0 overflow-visible"
						preserveAspectRatio="none"
					>
						<filter id="displacementFilter">
							<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="4" result="turbulence"></feTurbulence>
							<feDisplacementMap in2="turbulence" in="SourceGraphic" scale="12" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
						</filter>
						<style>
							:root {
								--pos-x: -4px;
								--pos-y: 0px;
								--rad-x: var(--radius-sm);
								--rad-y: var(--radius-sm);
								--width: calc(100% - 16px);
								--height: calc(100% - 16px);
								--transform: skewX(-2deg);
								--fill: var(--color-daintree-200);
								--stroke: var(--color-daintree-1000);
								--stroke-width: 8px;
							}
							@media screen and (min-width: var(--breakpoint-xl)) {
								:root {
									--pos-x: 4px;
									--pos-y: 4px;
									--rad-x: 8px;
									--rad-y: 8px;
									--width: calc(100% - 16px);
									--height: calc(100% - 16px);
									--transform: skewX(-4deg);
									--fill: var(--color-daintree-100);
									--stroke: var(--color-daintree-1000);
									--stroke-width: 8px;
								}
							}
							rect {
								x: var(--pos-x);
								y: var(--pos-y);
								rx: var(--rad-x);
								ry: var(--rad-y);
								width: var(--width);
								height: var(--height);
								transform: var(--transform);
								fill: var(--fill);
								stroke: var(--stroke);
								stroke-width: var(--stroke-width);
								stroke-linejoin: round;
								paint-order: stroke;
							}
						</style>
						<rect filter="url(#displacementFilter)"></rect>
					</svg>
					<div class="relative z-10 h-full w-full overflow-x-clip px-4 py-8">
						<form
							class="relative z-10 flex h-full flex-col justify-evenly gap-4"
							action="https://webhooktest.net/webhook/01a0ede0-54f9-714d-b900-d3eb2d6f6d48"
						>
							<div class="flex flex-row flex-wrap justify-start">
								<div class="flex flex-row gap-0">
									<RadioButton name="voucher" id="voucher20" value="20" label="20€" />
									<RadioButton name="voucher" id="voucher50" value="50" label="50€" />
									<RadioButton name="voucher" id="voucher100" value="100" label="100€" />
									<RadioButton name="voucher" id="voucher200" value="200" label="200€" />
								</div>
								<div class="flex w-full flex-row justify-between pr-6">
									<Button icon="Map" href={null} label="Checkout" kanji="金額" />
									<p>Payment Options</p>
								</div>
							</div>
							<p class="max-w-[60ch] pr-6 text-xs text-daintree-600">
								No physical card gets mailed out. Once you buy it, the gift card info is stored in our system and you'll get a printable version you
								can give however you want—stick it in a card, email it, wrap it up, whatever works. They just bring it up when they book. Giftcards
								are non-refundable.
							</p>
						</form>
					</div>
				</div>
			</div>
		</div>
	</TwoColumLayout>

	<style>
		.shape-outside {
			shape-outside: polygon(0% 0%, 100% 0%, 80% 100%, 0% 100%);
		}
	</style>
</Layout>
