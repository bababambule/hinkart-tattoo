---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import heroVideo from '../assets/hinkart-hero-fast1080pSource-modified-rf50-128audio.webm';
import heroVideoAlt from '../assets/videos/hero-video_720p-x265-rf40.mp4';
import heroPosterSrc from '../assets/hero-poster.jpg';
import IconButton from '../components/IconButton.astro';

const arrayPlayButton = ['Pause', 'Play'];
const arrayVolumeButton = ['SpeakerHighOff', 'SpeakerHigh'];
const arraySizeButton = ['Expand'];

// One value drives both the clip and the outline: on mobile the right edge is shortened, from lg the bottom edge.
const SLANT = 0.95;
const clipShapeMobile = `polygon(0% 0%, 100% 0%, 100% ${SLANT * 100}%, 0% 100%)`;
const clipShape = `polygon(0% 0%, 100% 0%, ${SLANT * 100}% 100%, 0% 100%)`;
const heroPoster = await getImage({ src: heroPosterSrc, format: 'webp', width: 1280 });
---

<Layout>
	<div
		class="index-wrapper relative flex h-[calc(100dvh-4rem)] flex-1 flex-col lg:h-[calc(100dvh-var(--footer-desktop-h))]"
		style={`--clip-shape-mobile: ${clipShapeMobile}; --clip-shape: ${clipShape}`}
	>
		<div class="index-bg pointer-events-none absolute top-0 left-0 z-10 size-full">
			<svg
				id="video-outline"
				data-slant={SLANT}
				width="100%"
				height="100%"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
				class="size-full overflow-visible"
				aria-hidden="true"
			>
				<filter id="video-boil" x="-5%" y="-5%" width="110%" height="110%">
					<feTurbulence type="turbulence" baseFrequency="0.015" numOctaves="2" seed="0" result="noise"></feTurbulence>
					<feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
				</filter>
				<polygon
					points="0,0 100,0 95,100 0,100"
					stroke="black"
					stroke-width="4"
					stroke-linejoin="round"
					vector-effect="non-scaling-stroke"
					filter="url(#video-boil)"></polygon>
			</svg>
		</div>
		<div class="relative flex h-full flex-1 flex-col">
			<div
				class="absolute right-4 bottom-4 z-20 flex origin-bottom-right scale-75 -skew-y-5 flex-row gap-4 lg:right-10 lg:bottom-10 lg:scale-100 lg:skew-y-0"
			>
				<IconButton id="play-button" label="Pause" icon={arrayPlayButton} />
				<IconButton id="vol-button" label="Unmute" icon={arrayVolumeButton} />
				<IconButton id="full-button" label="Fullscreen" icon={arraySizeButton} />
			</div>
			<video class="clip-path h-full flex-1 object-cover" id="heroVideo" poster={heroPoster.src} preload="metadata" autoplay playsinline muted loop>
				<source src={heroVideo} type="video/webm" />
				<source src={heroVideoAlt} type="video/mp4" />
			</video>
		</div>
	</div>
</Layout>

<style>
	.clip-path {
		clip-path: var(--clip-shape-mobile);
	}

	@media (width >= 64rem) {
		.clip-path {
			clip-path: var(--clip-shape);
		}
	}
</style>

<script src="../scripts/index.ts"></script>
