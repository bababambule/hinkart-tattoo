---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import example from '../assets/images/studio/studio-example.jpg';
---

<Layout>
	<div class="absolute right-16 bottom-24 top-8 left-1/6">
		<svg width="100%" height="100%" viewBox="0 0 1480 732" class="overflow-visible">
			<filter id="displacementFilter">
				<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="4" result="turbulence"></feTurbulence>
				<feDisplacementMap in2="turbulence" in="SourceGraphic" scale="12" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
			</filter>
			<defs>
				<mask id="letters">
					<path d="M0 0H252.586V202.977H108.355V264.176H252.586V731.328H0V528.351H144.412V467.152H0V0Z" fill="white" filter="url(#displacementFilter)"
					></path>
					<path d="M274.329 0H526.915V202.977H454.799V731.328H346.445V202.977H274.329V0Z" fill="white" filter="url(#displacementFilter)"></path>
					<path d="M693.071 0H801.244V731.328H548.658V0H657.013V528.351H693.071V0Z" fill="white" filter="url(#displacementFilter)"></path>
					<path
						d="M822.988 0H1039.52L1075.57 101.488V629.84L1039.52 731.328H822.988V0ZM931.343 202.977V528.351H967.401V202.977H931.343Z"
						fill="white"
						filter="url(#displacementFilter)"></path>
					<path d="M1097.32 731.328V0H1205.67V731.328H1097.32Z" fill="white" filter="url(#displacementFilter)"></path>
					<path
						d="M1227.41 731.328V0H1480V731.328H1227.41ZM1335.77 202.977V528.351H1371.83V202.977H1335.77Z"
						fill="white"
						filter="url(#displacementFilter)"></path>
				</mask>
			</defs>
			<!-- <rect width="100%" height="100%" fill="red" mask="url(#letters)"></rect> -->
			<image width="100%" height="100%" href={example.src} mask="url(#letters)" id="svgImage" />

			<path
				d="M0 0H252.586V202.977H108.355V264.176H252.586V731.328H0V528.351H144.412V467.152H0V0Z"
				fill="transparent"
				id="letterS"
				stroke="black"
				stroke-width="4"
				filter="url(#displacementFilter)"></path>
			<path
				d="M274.329 0H526.915V202.977H454.799V731.328H346.445V202.977H274.329V0Z"
				fill="transparent"
				id="letterT"
				filter="url(#displacementFilter)"
				stroke="black"
				stroke-width="4"></path>
			<path
				d="M693.071 0H801.244V731.328H548.658V0H657.013V528.351H693.071V0Z"
				fill="transparent"
				id="letterU"
				filter="url(#displacementFilter)"
				stroke="black"
				stroke-width="4"></path>
			<path
				d="M822.988 0H1039.52L1075.57 101.488V629.84L1039.52 731.328H822.988V0ZM931.343 202.977V528.351H967.401V202.977H931.343Z"
				fill="transparent"
				id="letterD"
				filter="url(#displacementFilter)"
				stroke="black"
				stroke-width="4"></path>
			<path
				d="M1097.32 731.328V0H1205.67V731.328H1097.32Z"
				fill="transparent"
				id="letterI"
				filter="url(#displacementFilter)"
				stroke="black"
				stroke-width="4"></path>
			<path
				d="M1227.41 731.328V0H1480V731.328H1227.41ZM1335.77 202.977V528.351H1371.83V202.977H1335.77Z"
				fill="transparent"
				id="letterO"
				filter="url(#displacementFilter)"
				stroke="black"
				stroke-width="4"></path>
		</svg>
	</div>
	<div class="size-full pr-24 relative z-10 flex flex-col justify-end items-end gap-12 pointer-events-none">
		<div id="kanjiTitle" class="font-kanji text-8xl text-daintree-200 text-button-stroke-daintree-400 -rotate-3 tracking-tighter">
			タトゥースタジオ
		</div>
		<div class="flex flex-col gap-8 mb-32 relative">
			<svg class="absolute size-full overflow-visible -z-10">
				<filter id="displacementFilter">
					<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="4" result="turbulence"></feTurbulence>
					<feDisplacementMap in2="turbulence" in="SourceGraphic" scale="8" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
				</filter>
				<rect
					x="4"
					y="4"
					rx="4"
					ry="4"
					fill="var(--color-daintree-100)"
					filter="url(#displacementFilter)"
					stroke-width="8"
					stroke="var(--color-daintree-1000)"
					stroke-linejoin="round"
					paint-order="stroke"
					width="100%"
					style="height:calc(100% - 2rem);"
				>
				</rect>
			</svg>
			<div class="flex flex-row gap-8 px-12 pt-8">
				<div class="flex flex-col text-2xl uppercase text-rose-bud-cherry-600 font-bold min-w-32">
					<div class="self-start flex flex-row gap-4">
						<p>Tue</p>
						<p>10H</p>
					</div>
					<div class="self-center">
						<p>Till</p>
					</div>
					<div class="self-end flex flex-row gap-4">
						<p>Sat</p>
						<p>17H</p>
					</div>
				</div>
				<div class="text-2xl uppercase text-daintree-900 font-bold max-w-[16ch]">
					<p>Verlengde oosterstraat 2 9711 en groningen</p>
				</div>
			</div>
			<div class="flex flex-row gap-8 pl-6">
				<div class="-rotate-6"><Button href="mailto:info@hinkart.nl" label="Message us" icon="Letter" /></div>
				<div class="rotate-4">
					<Button
						href="https://share.here.com/p/s-Yz1Cb2R5JTIwUGllcmNpbmclMjAlMjYlMjBUYXR0b29zO2lkPTUyOHUxa3d0LTIwNGE5MjdiMGU4ZWM4NWU3NjgyNWEzZWJiNmEzN2Q4O2xhdD01My4yMTQ2Njtsb249Ni41NzI5ODtuPUhpbmthcnQrVGF0dG9vK1N0dWRpbztwaD0=?z=15&t=normal"
						label="Find us"
						icon="Map"
						target="_blank"
					/>
				</div>
			</div>
		</div>
	</div>
</Layout>

<style>
	#kanjiTitle {
		-webkit-text-stroke-width: 0.75rem;
	}
</style>

<script src="../scripts/kanjiTitle.js"></script>
<script src="../scripts/studio.ts"></script>
