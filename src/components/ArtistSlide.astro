---
const { name, slug, video, index } = Astro.props;
import Icons from './Icons.astro';
import Button from './Button.astro';

const videos = import.meta.glob('../assets/videos/*.webm', { eager: true });
const videoPath = videos[`../assets/videos/${video}`]?.default;
---

<div class="embla__slide grow shrink-0 basis-full relative flex items-center min-w-1/5" data-slide-index={index}>
	<div class="video__wrapper relative bg-daintree-1000 p-2">
		<div class="video__overlay"></div>
		<video muted loop class="object-cover origin-center h-full">
			<source src={videoPath} />
		</video>
	</div>
	<div class="absolute z-10 bottom-1/4 mx-auto w-full flex justify-center">
		<p class="artist__name font-display text-daintree-600 text-4xl -rotate-3" data-name={name}>
			{name}
		</p>
		<p class="artist__name--shadow font-display text-daintree-600 text-4xl -rotate-3 absolute" data-name={name}>
			{name}
		</p>
	</div>
	<div class="absolute bottom-8 flex justify-center w-full">
		<Button label="Select" icon={null} href={slug} />
	</div>
</div>

