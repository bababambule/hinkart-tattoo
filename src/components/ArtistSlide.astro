<style>
	.embla__slide {
		min-width: 20%;
		padding-left: var(--slide-spacing);
		transform-origin: center;
	}

	.video__overlay {
		position: absolute;
		z-index: 1;
		width: 100%;
		height: 100%;
		mix-blend-mode: hard-light;
	}

	.text-stroke {
		-webkit-text-stroke: 0.2rem var(--color-tree-poppy-1000);
	}
</style>
