---
interface props {
	name: string;
	id: string;
	label: string;
	placeholder: string;
	maxLength: number;
	required: boolean;
}
const { name, id, label, placeholder, maxLength, required } = Astro.props;

import Icons from '../Icons.astro';
import Label from './Label.astro';
---

<label for={id} id=`${id}Wrapper` class="flex flex-col">
	<Label icon="map" size={48} label={label} />
	<div class="-rotate-1 origin-top-left relative">
		<textarea
			name={name}
			id={id}
			required={required}
			placeholder={placeholder}
			maxlength={maxLength}
			class="bg-daintree-700 w-full pl-4 pr-20 py-4 field-sizing-content resize-none wrap-break-word contain-inline-size text-daintree-100 rounded-sm transition-colors duration-200"
			class:list={['placeholder:text-daintree-500', 'hover:bg-daintree-800']}
			autocorrect="on"
			wrap="soft"
		/>
		<p data-name="inputLength" class="absolute right-0 z-10 top-1/2 -translate-y-1/2 text-daintree-300 text-xs pr-4"></p>
		<svg width="100%" height="4" class="size-full overflow-visible">
			<line x1="0" y1="2" x2="100%" y2="-6" stroke="black" stroke-width="4"></line>
		</svg>
	</div>
</label>

<style>
	input:focus {
		outline: var(--color-tree-poppy-400) solid 1px;
		outline-offset: 0.5rem;
		border-radius: 4px;
	}

	div:has(input:focus) line {
		stroke: white;
	}
</style>

<script>
	let Fields = document.querySelectorAll('textarea[maxlength]');

	Fields.forEach((field) => {
		let length;
		let inputLength = field.nextElementSibling;
		let inputMaxLength = parseInt(field.getAttribute('maxlength'));
		// console.log(field, inputMaxLength);
		if (inputMaxLength != NaN) {
		}

		field.addEventListener('keyup', () => {
			length = field.value.length;
			inputLength.textContent = `${length} / ${inputMaxLength}`;
		});
	});
</script>
