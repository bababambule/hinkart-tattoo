---
interface props {
	name: string;
	step: number;
	hidden: boolean;
}

const { name, step, hidden = true } = Astro.props;
---

<div data-step-name={name} data-step={step} data-hidden={hidden} class="flex flex-col gap-8 h-full">
	<slot />
</div>

<style>
	[data-hidden='true'] {
		display: none;
	}
</style>
