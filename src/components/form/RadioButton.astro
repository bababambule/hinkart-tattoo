---
import { multipleOf } from 'astro:schema';

type Color = 'white' | 'black';

interface props {
	name: string;
	id: string;
	value: string;
	label: string;
	color: Color;
	multi: boolean;
}

const { name, id, value, label, color, multi = false } = Astro.props;

let multiTag: string = multi === true ? 'checkbox' : 'radio';
---

<label
	for={id}
	class="relative min-h-16 min-w-16 w-fit flex flex-col justify-center align-middle cursor-pointer"
	data-input="radio"
	data-form-element="circleSelector"
>
	<input type={multiTag} class="sr-only" name={name} id={id} value={value} aria-multiselectable={multi} />
	<svg width="83" height="53" viewBox="0 0 83 53" fill="none" xmlns="http://www.w3.org/2000/svg" class="">
		<path
			class=`${name}svg`
			d="M36.063 2.12977L41.9835 1.22872L47.9573 1L53.9499 1.29322L59.7886 2.45069L65.5068 4.26932L71.0541 6.56315L75.6218 10.3925L79.7908 18.4366V23.7371L78.5754 27.379L75.8372 32.6607L71.4821 36.7647L66.7044 40.4335L61.7552 43.8255L56.2105 46.1318L50.4197 47.7673L44.5513 48.9649L38.5986 49.5134L32.6254 49.8149L26.6902 49.4887L20.8738 48.2124L15.1735 46.5276L9.78578 44.0624L5.27448 40.2682L1.87657 35.3424L1 29.6841L2.19413 23.7371L5.02329 18.6679L9.45238 14.6214L13.9594 10.712L18.9426 7.43289L24.5103 5.22737L30.248 3.5132L36.063 2.12977Z"
			stroke="var(--color-winter-sky-600)"
			stroke-width="4"
			stroke-linecap="round"
			stroke-linejoin="round"
			4
		></path>
	</svg>
	<p class="text-2xl absolute top-1/2 -translate-y-1/2 left-1/2 -translate-x-1/2">
		<span
			class="long-shadow-xs"
			class:list={[
				color === 'white'
					? 'text-daintree-100 text-button-stroke-daintree-1000 [--ls-from:var(--color-daintree-1000)] [--ls-to:var(--color-daintree-1000)]'
					: 'text-daintree-1000 text-button-stroke-daintree-100 [--ls-from:var(--color-daintree-100)] [--ls-to:var(--color-daintree-100)]',
			]}
		>
			{label}
		</span>
	</p>
</label>

<script src="../../scripts/RadioButton.ts"></script>
