---
import CheckboxField from './CheckboxField.astro';

interface props {
	title: string;
	text: Text;
	name: string;
	disabled: boolean;
	expanded: boolean;
}
const { title, text, name, disabled = true, expanded = false } = Astro.props;

const checkBoxName = `terms${name}`;
---

<div
	class="relative isolate overflow-hidden basis-20 px-1 py-2 group transition-all duration-500 interpolate"
	class:list={['aria-expanded:basis-auto']}
	data-form="termbox"
	aria-expanded={expanded}
>
	<label for={checkBoxName} class="relative cursor-pointer" id=`terms${name}Wrapper` data-disabled={disabled}>
		<svg
			class="h-full w-[96%] left-[2%] overflow-visible absolute -z-10 invisible"
			class:list={['group-aria-expanded:visible', 'xl:w-[98%]', 'xl:left-[1%]']}
		>
			<filter id="rough">
				<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="2" result="turbulence"></feTurbulence>
				<feDisplacementMap
					in2="turbulence"
					in="SourceGraphic"
					scale="2"
					xChannelSelector="R"
					yChannelSelector="G"
					result="displaced"
				></feDisplacementMap>
			</filter>
			<rect
				x="0"
				y="0"
				rx="4"
				width="100%"
				height="100%"
				fill="var(--color-daintree-600)"
				stroke="var(--color-daintree-1000)"
				stroke-width="4"
				filter="url(#rough)"
			></rect>
		</svg>
		<div>
			<div class="flex flex-row justify-between relative" class:list="">
				<svg class="size-full overflow-visible absolute -z-10">
					<filter id="rough" x="-30%" y="-30%" width="160%" height="160%">
						<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="2" result="turbulence"></feTurbulence>
						<feDisplacementMap
							in2="turbulence"
							in="SourceGraphic"
							scale="2"
							xChannelSelector="R"
							yChannelSelector="G"
							result="displaced"
						></feDisplacementMap>
					</filter>
					<rect
						x="0"
						y="0"
						width="100%"
						height="100%"
						fill="var(--color-daintree-100)"
						stroke="var(--color-daintree-1000)"
						stroke-width="4"
						filter="url(#rough)"
					></rect>
				</svg>
				<h2 class="relative text-button-stroke-daintree-1000 text-daintree-100 self-start max-w-fit -rotate-3">
					<span class="uppercase text-2xl font-bold px-4 py-2 leading-relaxed">{title}</span>
				</h2>
				<div class="-translate-y-3 -translate-x-3 -rotate-3">
					<CheckboxField name=`terms${name}` id=`terms${name}` />
				</div>
			</div>
			<p
				class="peer/body invisible size-0 text-daintree-100 px-6 py-4 max-w-[75ch] text-lg"
				class:list={['group-aria-expanded:visible', 'group-aria-expanded:size-auto']}
			>
				{text}
			</p>
		</div>
	</label>
</div>

<style>
	[data-disabled='true'] {
		pointer-events: none;
		opacity: 0.3;
	}
</style>
