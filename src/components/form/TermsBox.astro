---
import CheckboxField from './CheckboxField.astro';

interface props {
	title: string;
	text: Text;
	name: string;
	disabled: boolean;
	expanded: boolean;
}
const { title, text, name, disabled = true, expanded = false } = Astro.props;

const checkBoxName = `terms${name}`;
---

<div
	class="group relative isolate basis-20 overflow-hidden px-1 py-2 transition-all duration-500 interpolate"
	class:list={['aria-expanded:basis-auto']}
	data-form="termbox"
	aria-expanded={expanded}
>
	<label for={checkBoxName} class="relative cursor-pointer" id=`terms${name}Wrapper` data-disabled={disabled}>
		<svg
			class="invisible absolute left-[2%] -z-10 h-full w-[96%] overflow-visible"
			class:list={['group-aria-expanded:visible', 'xl:w-[98%]', 'xl:left-[1%]']}
		>
			<filter id="rough">
				<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="2" result="turbulence"></feTurbulence>
				<feDisplacementMap in2="turbulence" in="SourceGraphic" scale="2" xChannelSelector="R" yChannelSelector="G" result="displaced"
				></feDisplacementMap>
			</filter>
			<rect
				x="0"
				y="0"
				rx="4"
				width="100%"
				height="100%"
				fill="var(--color-daintree-600)"
				stroke="var(--color-daintree-1000)"
				stroke-width="4"
				filter="url(#rough)"></rect>
		</svg>
		<div>
			<div class="relative flex flex-row justify-between" class:list="">
				<svg class="absolute -z-10 size-full overflow-visible">
					<filter id="rough" x="-30%" y="-30%" width="160%" height="160%">
						<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="2" result="turbulence"></feTurbulence>
						<feDisplacementMap in2="turbulence" in="SourceGraphic" scale="2" xChannelSelector="R" yChannelSelector="G" result="displaced"
						></feDisplacementMap>
					</filter>
					<rect
						x="0"
						y="0"
						width="100%"
						height="100%"
						fill="var(--color-daintree-100)"
						stroke="var(--color-daintree-1000)"
						stroke-width="4"
						filter="url(#rough)"></rect>
				</svg>
				<h2 class="relative max-w-fit -rotate-3 self-start text-daintree-100 text-button-stroke-daintree-1000">
					<span class="px-4 py-2 text-2xl leading-relaxed font-bold uppercase">{title}</span>
				</h2>
				<div class="-translate-x-3 -translate-y-3 -rotate-3">
					<CheckboxField name=`terms${name}` id=`terms${name}` />
				</div>
			</div>
			<p
				class="peer/body invisible size-0 max-w-[75ch] px-6 py-4 text-lg text-daintree-100"
				class:list={['group-aria-expanded:visible', 'group-aria-expanded:size-auto']}
			>
				{text}
			</p>
		</div>
	</label>
</div>

<style>
	[data-disabled='true'] {
		pointer-events: none;
		opacity: 0.3;
	}
</style>
