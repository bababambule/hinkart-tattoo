---
interface Props {
	type: string;
	name: string;
	id: string;
	label: string;
	placeholder: string;
	maxLength: number;
	required: boolean;
}
const { type, name, id, label, placeholder, maxLength, required } = Astro.props;

import Icons from '../Icons.astro';
import Label from './Label.astro';
---

<label for={id} id=`${id}Wrapper` class="flex flex-col">
	<Label icon="map" size={48} label={label} />
	<div class="relative origin-top-left -rotate-1">
		<input
			type={type}
			name={name}
			id={id}
			required={required}
			placeholder={placeholder}
			maxlength={maxLength}
			class="w-full rounded-sm bg-daintree-700 py-4 pr-20 pl-8 text-daintree-100 transition-colors duration-200 placeholder:text-daintree-500 hover:bg-daintree-800"
		/>
		<p data-name="inputLength" class="absolute top-1/2 right-0 z-10 -translate-y-1/2 pr-4 text-xs text-daintree-300"></p>
		<svg width="100%" height="4" class="size-full overflow-visible">
			<line x1="0" y1="2" x2="100%" y2="-6" stroke="black" stroke-width="4"></line>
		</svg>
	</div>
</label>

<style>
	input:focus {
		outline: var(--color-tree-poppy-400) solid 1px;
		outline-offset: 0.5rem;
		border-radius: 4px;
	}

	div:has(input:focus) line {
		stroke: white;
	}
</style>

<script>
	let inputFields = document.querySelectorAll('input[maxlength]');

	inputFields.forEach((field) => {
		let length;
		let inputLength = field.nextElementSibling;
		let inputMaxLength = parseInt(field.getAttribute('maxlength'));
		console.log(field, inputMaxLength);
		if (inputMaxLength != NaN) {
		}

		field.addEventListener('keyup', () => {
			length = field.value.length;
			inputLength.textContent = `${length} / ${inputMaxLength}`;
		});
	});
</script>
