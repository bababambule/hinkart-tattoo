---
interface props {
	type: string;
	name: string;
	id: string;
	label: string;
	placeholder: string;
	maxLength: number;
	required: boolean;
}
const { type, name, id, label, placeholder, maxLength, required } = Astro.props;

import Icons from '../Icons.astro';
import Label from './Label.astro';
---

<label for={id} id=`${id}Wrapper` class="flex flex-col">
	<Label icon="map" size={48} label={label} />
	<div class="-rotate-1 origin-top-left relative">
		<input
			type={type}
			name={name}
			id={id}
			required={required}
			placeholder={placeholder}
			maxlength={maxLength}
			class="bg-daintree-700 w-full pl-8 pr-20 py-4 text-daintree-100 placeholder:text-daintree-500 hover:bg-daintree-800 rounded-sm transition-colors duration-200"
		/>
		<p data-name="inputLength" class="absolute right-0 z-10 top-1/2 -translate-y-1/2 text-daintree-300 text-xs pr-4">test</p>
		<svg width="100%" height="4" class="size-full overflow-visible">
			<line x1="0" y1="2" x2="100%" y2="-6" stroke="black" stroke-width="4"></line>
		</svg>
	</div>

	<style>
		input:focus {
			outline: var(--color-tree-poppy-400) solid 1px;
			outline-offset: 0.5rem;
			border-radius: 4px;
		}

		div:has(input:focus) line {
			stroke: white;
		}
	</style>

	<script>
		let inputFields = document.querySelectorAll('input[type="text"]');

		inputFields.forEach((field) => {
			let length;
			let inputLength = field.nextElementSibling;
			let inputMaxLength = parseInt(field.getAttribute('maxlength'));

			field.addEventListener('keyup', () => {
				if (inputMaxLength != null) {
					length = field.value.length;
					inputLength.textContent = `${length} / ${inputMaxLength}`;
				}
			});
		});
	</script>
</label>
