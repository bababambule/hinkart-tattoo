---

---

<label class="switch -rotate-3">
	<input type="checkbox" />
	<span class="slider"></span>
</label>

<style>
	/* The switch - the box around the slider */
	.switch {
		position: relative;
		display: inline-block;
		margin: 1rem;
		width: 12rem;
		height: 4rem;
		border-radius: var(--radius-md);
		border: solid 0.25rem var(--color-daintree-1000);
	}

	/* Hide default HTML checkbox */
	.switch input {
		opacity: 0;
		width: 0;
		height: 0;
	}

	/* The slider */
	.slider {
		position: absolute;
		cursor: pointer;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: var(--color-winter-sky-50);
		-webkit-transition: 0.4s;
		transition: 0.4s;
	}

	.slider:before {
		position: absolute;
		content: 'No';
		height: calc(100% + 0.5rem);
		width: calc(50% + 0.25rem);
		display: flex;
		justify-content: center;
		align-items: center;
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		left: -0.25rem;
		bottom: -0.25rem;
		background-color: var(--color-daintree-600);
		color: var(--color-daintree-100);
		-webkit-transition: 0.4s;
		transition: 0.4s;
		border-radius: var(--radius-sm);
		border: solid 0.25rem var(--color-daintree-1000);
	}

	input:checked + .slider {
	}

	input:focus + .slider {
		box-shadow: 0 0 1px #2196f3;
	}

	input:checked + .slider:before {
		content: 'Yes';
		background-color: var(--color-winter-sky-600);
		transform: translateX(100%);
	}
</style>
