---
import { getCollection } from 'astro:content';

const artists = (await getCollection('artists')).sort((a, b) => a.data.order - b.data.order);
---

<div class="grid grid-cols-3 gap-2 lg:grid-cols-4">
	{
		artists.map((artist) => (
			<label for={artist.data.name} class="group/label relative flex aspect-square w-full cursor-pointer items-end justify-center border-2">
				<input type="radio" id={artist.data.name} name="artistSelection" value={artist.data.name} class="group/input sr-only" />
				<p class="relative z-10 max-w-full overflow-x-clip px-2">
					<span class="font-display text-xl text-winter-sky-50 text-button-stroke-winter-sky-1000 md:text-2xl">{artist.data.name}</span>
				</p>
				<svg
					class="pointer-events-none absolute inset-0 size-full overflow-visible"
					viewBox="0 0 100 100"
					preserveAspectRatio="none"
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
				>
					<filter id="artistFilter" x="-30%" y="-30%" width="160%" height="160%">
						<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="2" result="turbulence" />
						<feDisplacementMap in2="turbulence" in="SourceGraphic" scale="2" xChannelSelector="R" yChannelSelector="G" result="displaced" />
					</filter>
					<image
						x="0"
						y="0"
						width="100%"
						height="100%"
						href={artist.data.image.src}
						filter="url(#artistFilter)"
						stroke-width="2"
						stroke="var(--color-tree-poppy-1000)"
					/>
					<rect
						x="0"
						y="0"
						width="100%"
						height="100%"
						stroke-width="2"
						stroke="var(--color-tree-poppy-1000)"
						fill="var(--color-winter-sky-600)"
						class="invisible mix-blend-multiply"
						class:list={['group-has-checked/label:visible']}
					/>
				</svg>
			</label>
		))
	}
</div>
