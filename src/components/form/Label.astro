---
interface props {
	label: string;
	icon: string;
	size: number;
}
const { label, icon, size = 48 } = Astro.props;

import Icons from '../Icons.astro';
---

<div class="relative z-10 flex max-w-fit flex-row items-end justify-start">
	<svg viewBox="0 0 100 100" preserveAspectRatio="none" class="absolute bottom-0 left-0 -z-10 h-3/4 w-full overflow-visible">
		<polygon
			points="2,20 100,-5 95,105 -2,98"
			fill="var(--color-tree-poppy-600)"
			stroke="var(--color-tree-poppy-1000)"
			stroke-width="4"
			class="size-full"></polygon>
	</svg>
	<div class="translate-y-2">
		<Icons icon={icon} size={size} classes="text-tree-poppy-100 z-10" />
	</div>
	<div class="pr-6 pl-2 font-bold uppercase">
		<p>{label}</p>
	</div>
</div>
