---
const { id, paramName, label, icon } = Astro.props;

import Label from './Label.astro';
---

<div class="translate-y-2 relative z-10">
	<Label label={label} icon={icon} />
</div>
<div
	id={id}
	data-dropzone={paramName}
	class="dropzone relative p-8 grid grid-cols-2 border-4! border-dashed border-daintree-1000 bg-daintree-700 gap-2"
>
</div>

<script src="../../scripts/fileupload.ts"></script>

<style is:global>
	.dropzone .dz-preview {
		width: unset !important;
		margin: 0.5rem 0.4rem !important;
	}
	.dropzone .dz-preview.dz-image-preview {
		background: none !important;
		outline: solid 4px var(--color-daintree-1000);
		width: 100%;
	}

	.dz-image {
		border-radius: 0px !important;
		width: unset !important;
	}

	.dropzone .dz-preview .dz-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
	}

	.dropzone .dz-preview .dz-remove {
		border-top: solid 4px var(--color-daintree-1000);
		background: var(--color-winter-sky-600);
		color: var(--color-winter-sky-100);
		padding: 0.5rem;
		font-weight: bold;
	}

	.dropzone .dz-message {
		grid-column: 1 / span 2;
	}

	.dz-button {
		font-family: var(--font-display) !important;
		text-align: center;
		font-size: var(--text-6xl) !important;
		line-height: 100% !important;
		color: var(--color-daintree-500) !important;
	}
</style>
