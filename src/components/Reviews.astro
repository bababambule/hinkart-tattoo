---
import FaceEmoji from '../components/icons/ReviewFace.astro';
import ReviewTitle from '../components/icons/InkedAndHappy.astro';
import ReviewSlider from './ReviewSlider.astro';
---

<!-- <div class="border-tree-poppy-1000 border-2 outline-tree-poppy-600 outline-2 bg-linear-0 from-tree-poppy-600 from-75% to-black to-75% rounded-md w-32 h-40 absolute right-0 top-64 z-50 rotate-3 translate-x-2">
	<div>
		
	</div>
	<p>レビュー</p>
	<p>★★★★★</p>
	<p>118 Reviews</p>
</div>


 -->

<div class="px-4 text mb-12 relative">
	<button popovertarget="reviews" class="absolute size-full z-50 cursor-pointer"></button>
	<div class="bg-tree-poppy-600 w-full rounded-md border-4 border-tree-poppy-1000 outline-4 outline-tree-poppy-600 py-2 px-4">
		<div>
			<ReviewTitle />
		</div>
		<div class="">
			<FaceEmoji />
		</div>
		<svg viewBox="0 -20 100 24" class="font-kanji" preserveAspectRatio="xMidYMid meet">
			<text
				font-size="var(--text-xl)"
				fill="var(--color-tree-poppy-100)"
				x="0"
				y="0"
				dx="0"
				dy="0"
				lengthAdjust="spacingAndGlyphs"
				textLength="100%"
				filter="url(#displacementFilter)"
				text-rendering="optimizeLegibility"
			>
				レビュー
			</text>
		</svg>
		<div class="flex flex-row justify-around text-tree-poppy-900">
			<p class="tracking-widest">★★★★★</p>
			<p class="font-bold uppercase">118 Reviews</p>
		</div>
	</div>
</div>

<div popover id="reviews">
	<div class="flex justify-center items-center bg-red-600">
		<ReviewSlider />
	</div>
</div>
