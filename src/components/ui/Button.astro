---
interface Props {
	icon: string | null;
	href?: string | null;
	label: string;
	kanji: string;
	id: string;
	target: string;
	disabled: boolean;
	hidden: boolean;
	popovertarget: string | null;
}

const { icon, href, label, kanji, id, target, disabled, hidden = false, popovertarget } = Astro.props;

let Tag;
let Destination;

if (href == '' && href == null) {
	Tag = 'button';
} else {
	Tag = 'a';
}

if (target != '') {
	Destination = target;
} else {
	Destination = '_self';
}

import Icons from '../Icons.astro';
---

<Tag
	href={href}
	target={Destination}
	id={id}
	class="button group relative isolate inline-flex min-h-16 min-w-12 items-center gap-3 self-center px-4 data-icon:pl-0 lg:px-6"
	data-icon={icon}
	data-disabled={disabled}
	data-hidden={hidden}
	popovertarget={popovertarget}
>
	<div class="pointer-events-none flex flex-row items-center justify-center">
		{
			icon && (
				<div class="z-10 ml-1.5 text-winter-sky-1000 group-hover:text-tree-poppy-100">
					<Icons icon={icon} size={48} classes="rotate-3 -translate-y-2 icon-shadow" />
				</div>
			)
		}
		<div
			class="origin-top-left -rotate-3 text-tree-poppy-100 [--ls-from:var(--color-tree-poppy-1000)] [--ls-to:var(--color-tree-poppy-1000)] long-shadow-xs group-hover:text-tree-poppy-1000 group-hover:[--ls-from:var(--color-tree-poppy-100)] group-hover:[--ls-to:var(--color-tree-poppy-100)]"
		>
			<p class="text-2xl font-bold uppercase text-button-stroke-tree-poppy-1000 group-hover:text-button-stroke-tree-poppy-100" data-ui="buttonLabel">
				{label}
			</p>
		</div>
	</div>
	<div id="Mask" class="kanji-mask pointer-events-none absolute -z-10 flex size-full flex-row items-end justify-end opacity-40">
		<div class="-rotate-24 text-right text-tree-poppy-100">
			<p class="font-kanji text-4xl" data-ui="buttonKanji">{kanji}</p>
		</div>
	</div>
	<svg
		class="pointer-events-none absolute inset-0 -z-20 size-full overflow-visible"
		viewBox="0 0 100 100"
		preserveAspectRatio="none"
		aria-hidden="true"
	>
		<filter id="displacementShadow" x="-30%" y="-30%" width="160%" height="160%">
			<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="2" result="turbulence"></feTurbulence>
			<feDisplacementMap in2="turbulence" in="SourceGraphic" scale="2" xChannelSelector="R" yChannelSelector="G" result="displaced"
			></feDisplacementMap>

			<feDropShadow in="displaced" dx="4" dy="8" stdDeviation="0" flood-color="var(--color-tree-poppy-1000)" flood-opacity="1" result="shadow3"
			></feDropShadow>
			<feDropShadow in="displaced" dx="2" dy="4" stdDeviation="0" flood-color="var(--color-tree-poppy-1000)" flood-opacity="1" result="shadow2"
			></feDropShadow>
			<feDropShadow in="displaced" dx="1" dy="2" stdDeviation="0" flood-color="var(--color-tree-poppy-1000)" flood-opacity="1" result="shadow1"
			></feDropShadow>

			<feMerge>
				<feMergeNode in="shadow3"></feMergeNode>
				<feMergeNode in="shadow2"></feMergeNode>
				<feMergeNode in="shadow1"></feMergeNode>
				<feMergeNode in="displaced"></feMergeNode>
			</feMerge>
		</filter>
		<polygon
			x="0"
			y="0"
			points="0,6 99,0 97,92 0,86"
			stroke-width="2"
			stroke="var(--color-tree-poppy-1000)"
			width=" 100%"
			height="100%"
			fill="var(--color-winter-sky-600)"
			filter="url(#displacementShadow)"></polygon>
	</svg>
</Tag>

<style>
	[data-disabled='true'] {
		pointer-events: none;
		filter: grayscale();
		opacity: 0.6;
	}

	[data-hidden='true'] {
		display: none;
	}

	.kanji-mask {
		clip-path: polygon(0 6%, 99% 0, 97% 92%, 0 86%);
	}
</style>

<script src="../../scripts/button.ts"></script>
