---
---

<svg
	id="hinkartLogo"
	height="100%"
	width="100%"
	viewBox="0 0 110 216"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	class="overflow-visible pointer-none:"
>
	<defs>
		<!-- Shared geometry: defined once, reused for mask + artwork -->
		<path
			id="hk-left"
			d="M34.2608 190.207V0C29.8756 16.3664 17.843 23.9897 3.99604 25.1906C1.79517 25.3814 0 27.1518 0 29.3609V215.568H11.4609C34.2608 215.568 34.2608 190.207 34.2608 190.207Z"
			vector-effect="non-scaling-stroke"
		/>
		<path
			id="hk-right"
			d="M75.2289 190.207V0C80.0314 17.9234 94.0053 25.3609 109.49 25.3609V215.568H98.0288C75.2289 215.568 75.2289 190.207 75.2289 190.207Z"
			vector-effect="non-scaling-stroke"
		/>
		<path
			id="hk-drop"
			d="M75.7141 110.782C75.7141 121.119 68.1446 136.314 54.743 136.314C41.3414 136.314 33.772 121.368 33.772 110.782C33.772 98.9494 54.743 83.1316 54.743 66.8156C54.743 83.1316 75.7141 98.9494 75.7141 110.782Z"
			vector-effect="non-scaling-stroke"
		/>

		<mask id="hk-mask">
			<g fill="white">
				<use href="#hk-left" />
				<use href="#hk-right" />
				<use href="#hk-drop" />
			</g>
		</mask>

		<!-- Wobbly edges + 6-step hard extrusion shadow -->
		<filter id="hk-fx" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
			<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="2" result="noise" />
			<feDisplacementMap in="SourceGraphic" in2="noise" scale="2" xChannelSelector="R" yChannelSelector="G" result="displaced" />

			<feFlood flood-color="var(--color-rose-bud-cherry-1000)" />
			<feComposite in2="displaced" operator="in" result="silhouette" />

			<feOffset in="silhouette" dx="1" dy="2" result="s1" />
			<feOffset in="silhouette" dx="3" dy="4" result="s2" />
			<feOffset in="silhouette" dx="5" dy="6" result="s3" />
			<feOffset in="silhouette" dx="7" dy="8" result="s4" />
			<feOffset in="silhouette" dx="9" dy="10" result="s5" />
			<feOffset in="silhouette" dx="11" dy="12" result="s6" />

			<feMerge>
				<feMergeNode in="s6" />
				<feMergeNode in="s5" />
				<feMergeNode in="s4" />
				<feMergeNode in="s3" />
				<feMergeNode in="s2" />
				<feMergeNode in="s1" />
				<feMergeNode in="displaced" />
			</feMerge>
		</filter>
	</defs>

	<!-- Background badge -->
	<circle
		cx="55%"
		cy="55%"
		r="55%"
		fill="var(--color-rose-bud-cherry-100)"
		stroke="var(--color-rose-bud-cherry-1000)"
		stroke-width="4"
		vector-effect="non-scaling-stroke"
		filter="url(#hk-fx)"
	/>

	<!-- Logo -->
	<g id="logo" filter="url(#hk-fx)" stroke="var(--color-rose-bud-cherry-1000)" stroke-width="8" stroke-linejoin="round">
		<!-- dark outline under the drop -->
		<use href="#hk-drop" fill="var(--color-daintree-1000)" />

		<g fill="var(--color-rose-bud-cherry-600)" paint-order="stroke">
			<use href="#hk-left" />
			<use href="#hk-right" />
			<use href="#hk-drop" stroke="none" />
		</g>
	</g>
</svg>

<script>
	import { createLogoAnimator } from '../scripts/hinkartLogoAnimations';

	const svg = document.querySelector<SVGSVGElement>('#hinkartLogo');
	if (svg) {
		const anim = createLogoAnimator(svg);
		anim.play('inkDrip');

		window.addEventListener('load', async () => {
			await anim.finish(); // lands the current pass (max 1.2 s)
			anim.play('lineBoil');
		});
		svg.addEventListener('mouseover', () => {
			anim.play('needleBuzz');
		});
		svg.addEventListener('mouseout', () => {
			anim.play('lineBoil');
		});
	}
</script>
