---
import Logo from './Logo.astro';
---

<header class:list={['w-full h-16 relative mt-4 z-20']}>
	<div class:list={['header-bg h-12 absolute top-0 left-0 size-full translate-y-2.5 px-2']}>
		<svg id="header-bg" height="100%" preserveAspectRatio="none" viewBox="0 0 100 20" class="overflow-visible w-[98%]">
			<defs>
				<filter id="headerFilter" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
					<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="2" result="turbulence"></feTurbulence>
					<feDisplacementMap
						in2="turbulence"
						in="SourceGraphic"
						scale="2"
						xChannelSelector="R"
						yChannelSelector="G"
						result="displaced"
					></feDisplacementMap>
				</filter>
			</defs>
			<rect
				x="0"
				y="0"
				rx="2"
				ry="2"
				width="100%"
				height="100%"
				fill="var(--color-rose-bud-cherry-50)"
				stroke="var(--color-rose-bud-cherry-1000)"
				stroke-width="3"
				filter="url(#headerFilter)"
				vector-effect="non-scaling-stroke"
			></rect>
		</svg>
	</div>
	<div class:list={['header-main', 'relative z-10 h-16', 'flex flex-row justify-center items-center']}>
		<a href="/" class:list={['scale-35']}>
			<Logo />
		</a>
	</div>
</header>

<script src="../scripts/header.ts"></script>
