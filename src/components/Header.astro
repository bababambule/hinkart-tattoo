---
import NavLogo from './NavLogo.astro';
import Button from './Button.astro';
import Navigation from './Navigation.astro';
---

<header
	transition:persist
	transition:name="site-header"
	transition:animate="none"
	class="flex flex-row justify-between px-4 group pt-4 items-end fixed z-50 w-dvw left-0 right-0 top-0
		lg:w-1/5 lg:h-screen lg:flex-col lg:left-0"
>
	<NavLogo />
	<!-- Change menu to hide at 1280 (breakpoint xl or alternatively use a container query) -->
	<input type="checkbox" id="sidebar-active" class="sr-only lg:hidden" />
	<label
		for="sidebar-active"
		class="w-fit overflow-hidden
		lg:hidden"
	>
		<Button
			href=""
			label="Menu"
			id="sidebarOpenBtn"
			popovertarget={null}
			kanji="メニュー"
			href=""
			icon={null}
			target=""
			disabled={false}
			hidden={false}
		/>
	</label>
	<label for="sidebar-active" id="sidebar-backdrop" class="lg:hidden sr-only"></label>
	<Navigation />
	<div
		class="absolute left-0 top-0 right-0 h-dvw w-26 -z-10 -rotate-90 origin-top-left
		bg-[url(../assets/sidebar-bgx2.webp)] bg-right bg-no-repeat bg-cover -scale-x-100
		sm:w-32
		md:w-40 md:-rotate-90
		lg:scale-x-100 lg:bg-right lg:h-screen lg:-rotate-0 lg:w-full"
	></div>
</header>

<script>
	const menuCheckbox = document.getElementById('sidebar-active');
	const menuOpenBtn = document.getElementById('sidebarOpenBtn');
	const menuCloseBtn = document.getElementById('sidebarCloseBtn');
	const menuBackdrop = document.getElementById('sidebar-backdrop');
	const navBtns = document.querySelectorAll('.nav-btn');
	const headerHome = document.getElementById('headerLogoLink');

	if (menuCheckbox instanceof HTMLInputElement) {
		const checkbox = menuCheckbox;

		menuOpenBtn?.addEventListener('click', (e) => {
			e.preventDefault();
			checkboxToggle();
		});

		menuCloseBtn?.addEventListener('click', (e) => {
			e.preventDefault();
			checkboxToggle();
		});

		navBtns.forEach((btn) => {
			btn.addEventListener('click', (e) => {
				checkboxToggle();
			});
		});
		headerHome?.addEventListener('click', (e) => {
			if (checkbox.checked) {
				checkboxToggle();
			}
		});

		function checkboxToggle() {
			checkbox.checked = !checkbox.checked;
		}

		checkbox.checked = false;
	}
</script>

<script src="../scripts/header.ts"></script>
<script src="../scripts/menu.ts"></script>
