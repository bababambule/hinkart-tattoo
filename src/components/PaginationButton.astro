---
import Icons from "./Icons.astro"
const { label, type } = Astro.props

const labelPrev = "top-1/3 left-1/4 -skew-3"
const labelNext = "top-1/4 left-1/8 skew-3"
---
<div class={`embla__${type} pointer-events-auto cursor-pointer relative`}>
    <p class={`font-display text-daintree-100 text-3xl absolute ${ type == "prev" ? labelPrev : labelNext }`}>{label}</p>
    { type == "prev" 
        ? <Icons icon="PrevArrow" size={128} classes="text-regal-blue-600" /> 
        :  <Icons icon="NextArrow" size={128} classes="text-regal-blue-600" /> 
    }
</div>

<script>
    import { gsap } from 'gsap'

    function buttonAnimation(btnType) {
        document.querySelectorAll<HTMLElement>(".embla__" + btnType).forEach((btn) => {
            const label = btn.querySelector<HTMLElement>("p");
            const shape = btn.querySelector<HTMLElement>("svg");
            const deg = btnType == "prev" ? 3 : -3
            let tl = gsap.timeline({
                paused: true,
                defaults: {
                    duration: 0.2, 
                    ease: "elastic.out(1,0.3)",
                }
            });
            tl.to(btn, {
                scale: 1.25
            }, 0)
            tl.to(label, {
                rotate: deg,
                filter: 'drop-shadow(4px 4px 0px #000)',
                zIndex: 9,
            }, 0)
            tl.to(shape, {
                filter: 'drop-shadow(4px 4px 0px #000)'
            }, 0)

            btn.addEventListener("mouseover", () => {
                tl.play();
            })
            btn.addEventListener("mouseleave", () => {
                tl.reverse();
            })
        })
    }

    buttonAnimation("prev")
    buttonAnimation("next")
    
</script>