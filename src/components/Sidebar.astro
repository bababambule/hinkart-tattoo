---
import NavButton from "../components/NavButton.astro";
import SidebarBg from '../assets/sidebar-bg.webp';
console.log(SidebarBg);
---
<header class="w-1/3  h-screen z-40 fixed left-0">
    <div class="flex flex-col">
        <div class="h-24 bg-amber-50">
            <a href="/">Logo</a>
        </div>
        <div class="flex flex-col gap-5 justify-center w-full">
            <NavButton url="/artists" text="Artists" kanji="アーティスト" skewX="-6" skewY="-3" posX="0" />
            <NavButton url="/studio" text="Studio" kanji="スタジオ" skewX="-12" skewY="0" posX="2" posY="-3" />
            <NavButton url="/about" text="About" kanji="じこしょうかい" skewX="-6" skewY="-3" posX="1" />
            <NavButton url="/booking" text="Booking" kanji="よやく" skewX="-6" skewY="-6" posX="2" />
            <NavButton url="/aftercare" text="Aftercare" kanji="アフターケア" skewX="-12" skewY="0" posX="0" posY="-2" />
            <NavButton url="/giftcards" text="Giftcards" kanji="ギフトカード" skewX="-3" skewY="-3" posX="1" posY="1" />
        </div>
    </div>
    <div class="absolute left-0 top-0 -z-10 h-screen w-[25dvw] bg-[url(../assets/sidebar-bg.webp)] bg-right"></div>
</header>

<!-- Include load animation for sidebar. Background and buttons flying in form left side. Staggered animation -->