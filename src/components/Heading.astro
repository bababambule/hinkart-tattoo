---
interface props {
  title: string;
}

const { title = "Hinkart" } = Astro.props;
---

<svg width="100%" class="long-shadow-sm [--ls-from:black] [--ls-to:black]">
  <filter id="displacementFilter">
    <feTurbulence
      type="turbulence"
      baseFrequency="0.01"
      numOctaves="2"
      result="turbulence"></feTurbulence>
    <feDisplacementMap
      in2="turbulence"
      in="SourceGraphic"
      scale="2"
      xChannelSelector="R"
      yChannelSelector="G"></feDisplacementMap>
  </filter>
  <text
    x="0"
    y="110"
    lengthAdjust="spacingAndGlyphs"
    class="font-display text-9xl"
    fill="var(--color-daintree-200)"
    filter="url(#displacementFilter)"
    stroke-width="8"
    stroke="var(--color-daintree-1000)"
    stroke-linejoin="round"
    paint-order="stroke"
  >
    {title}
  </text>
</svg>
