---
interface Props {
	title: string;
	size: string;
	yPos: number;
}

const { title = 'Hinkart', size = 'text-9xl', yPos = 110 } = Astro.props;
---

<svg width="100%" class="[--ls-from:black] [--ls-to:black] long-shadow-sm">
	<filter id="displacementFilter">
		<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="2" result="turbulence"></feTurbulence>
		<feDisplacementMap in2="turbulence" in="SourceGraphic" scale="2" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
	</filter>
	<text
		x="0"
		y={yPos}
		lengthAdjust="spacingAndGlyphs"
		class:list={['font-display', size]}
		fill="var(--color-daintree-200)"
		filter="url(#displacementFilter)"
		stroke-width="8"
		stroke="var(--color-daintree-1000)"
		stroke-linejoin="round"
		paint-order="stroke"
	>
		{title}
	</text>
</svg>
