---
import NavButton from './NavButton.astro';
---

<nav
	class="h-screen hidden w-full fixed right-0 top-0 flex-col justify-center items-center gap-5 pr-12
	group-has-checked:flex
	lg:flex lg:flex-1 lg:flex-col lg:justify-start lg:gap-2 lg:pt-4 lg:h-auto lg:relative lg:items-start
	xl:pl-8 xl:items-end
	2xl:items-end"
>
	<NavButton
		url="/artists"
		text="Artists"
		kanji="アーティスト"
		classes="-skew-x-6 -skew-y-3 
			lg:translate-x-0
			xl:translate-x-12"
	/>
	<NavButton
		url="/studio"
		text="Studio"
		kanji="スタジオ"
		classes="-skew-x-12 
			lg:translate-x-14 lg:-translate-y-1
			xl:translate-x-24"
	/>
	<NavButton
		url="/about"
		text="About"
		kanji="じこしょうかい"
		classes="-skew-x-6 -skew-y-3 
			lg:translate-x-4
			xl:translate-x-12"
	/>
	<NavButton
		url="/booking"
		text="Booking"
		kanji="よやく"
		classes="-skew-x-6 -skew-y-6 
			lg:translate-x-12
			xl:translate-x-24"
	/>
	<NavButton
		url="/aftercare"
		text="Aftercare"
		kanji="アフターケア"
		classes="-skew-x-12 -skew-y-1
			lg:translate-x-0
			xl:translate-x-24"
	/>
	<NavButton
		url="/giftcards"
		text="Giftcards"
		kanji="ギフトカード"
		classes="-skew-x-3 -skew-y-3 
			lg:translate-x-4 lg:translate-y-1
			xl:translate-x-24"
	/>
</nav>
