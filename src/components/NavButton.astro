---
interface Props {
	url: string;
	text: string;
	kanji: string;
	classes: string;
}
const { url, text, kanji, classes } = Astro.props;

const currentPath = Astro.url.pathname;
const isActive = currentPath === url || currentPath.startsWith(`${url}/`);
---

<a
	href={url}
	target="_self"
	data-nav-url={url}
	class:list={[
		'box relative font-black px-8 py-4 w-fit nav-btn rounded-sm',
		'text-xl lg:text-2xl xl:text-2xl 2xl:text-4xl ',
		'bg-daintree-1000 text-daintree-100',
		'origin-left cursor-pointer pointer-events-auto',
		classes,
		isActive ? 'hidden' : 'block',
	]}
>
	<p class="label uppercase font-display tracking-wide block">{text}</p>
	<div class="bar bg-amber-500 h-3 w-full absolute left-0 right-0 bottom-0 scale-y-0 opacity-0 origin-bottom translate-x-"></div>
</a>

<div
	data-nav-url={url}
	class={`nav-btn--active ${isActive ? 'block' : 'hidden'} ${classes} relative bg-pink-600 text-pink-50 w-fit rounded-sm origin-left border-daintree-1000 border-4 px-8 pb-2`}
>
	<p class="label stroke-text uppercase font-display tracking-wide block text-5xl relative -mt-4 mb-1" data-stroke-text={text}>
		{text}
	</p>
	<div class="flex w-full py-2 content-center gap-2">
		<div class="bar-left bg-tree-poppy-600 border-tree-poppy-1000 border-4 rounded-sm h-4 flex-1 -ml-12"></div>
		<span class="kanji flex-none font-kanji text-xl leading-3 tracking-tighter">{kanji}</span>
		<div class="bar-right bg-tree-poppy-600 border-tree-poppy-1000 border-4 rounded-sm h-4 flex-1 -mr-12"></div>
	</div>
</div>

<script>
	import '../scripts/navButton.ts';
</script>

<style>
	.stroke-text::after {
		content: attr(data-stroke-text);
		-webkit-text-stroke: 0.75rem black;
		color: black;
		display: block;
		position: absolute;
		top: 2px;
		right: 2px;
		z-index: -1;
	}
</style>
