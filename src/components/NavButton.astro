---
const { url, text, kanji, skewX, skewY} = Astro.props

const skewXMap: Record<string, string> = {
    "0": "skew-x-0",
    "3": "skew-x-3",
    "6": "skew-x-6",
    "12": "skew-x-12",
    "-3": "-skew-x-3",
    "-6": "-skew-x-6",
    "-12": "-skew-x-12",
};

const skewYMap: Record<string, string> = {
    "0": "skew-y-0",
    "3": "skew-y-3",
    "6": "skew-y-6",
    "12": "skew-y-12",
    "-3": "-skew-y-3",
    "-6": "-skew-y-6",
    "-12": "-skew-y-12",
};

const currentPath = Astro.url.pathname;
const isActive = currentPath === url || currentPath.startsWith(`${url}/`);
---
<div class={`box ${skewXMap[skewX]} ${skewYMap[skewY]} relative bg-daintree-1000 text-daintree-100 font-black text-5xl px-8 py-4 w-fit group nav-btn rounded-sm`}>
    <a href={url} target="_self" class="label uppercase font-display tracking-wide block">
        {text}
    </a>
    <div class="bar bg-amber-500 h-3 w-full absolute left-0 right-0 bottom-0 scale-y-0 opacity-0 origin-bottom"></div>
</div>

<script>
import { gsap } from "gsap";

    document.querySelectorAll<HTMLElement>(".nav-btn").forEach((btn) => {
        const label = btn.querySelector(".label");
        const bar = btn.querySelector(".bar");

        btn.addEventListener("mouseenter", () => {
            gsap.to(label, {
                y: -10,
                duration: .5,
                ease: "elastic.out(1,0.3)"
            });
            gsap.to(bar, {
                opacity: 1,
                scaleY: 1,
                duration: .8,
                ease: "elastic.out(1,0.3)"
            })
        });

        btn.addEventListener("mouseleave", () => {
            gsap.to(label, {
                y: 0,
                duration: .5,
                ease: "elastic.out(1,0.3)"
            });
            gsap.to(bar, {
                opacity: 0,
                scaleY: 0,
                duration: .8,
                ease: "elastic.out(1,0.3)"
            })
        })
    });
</script>