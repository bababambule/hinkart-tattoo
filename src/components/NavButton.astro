---
const { url, text, kanji, skewX, skewY, posX, posY} = Astro.props

const skewXMap: Record<string, string> = {
    "0": "skew-x-0",
    "3": "skew-x-3",
    "6": "skew-x-6",
    "12": "skew-x-12",
    "-3": "-skew-x-3",
    "-6": "-skew-x-6",
    "-12": "-skew-x-12",
};

const skewYMap: Record<string, string> = {
    "0": "skew-y-0",
    "3": "skew-y-3",
    "6": "skew-y-6",
    "12": "skew-y-12",
    "-3": "-skew-y-3",
    "-6": "-skew-y-6",
    "-12": "-skew-y-12",
};

const posXMap: Record<string, string> = {
    "0": "translate-x-2",
    "1": "translate-x-12",
    "2": "translate-x-24",
}

const posYMap: Record<string, string> = {
    "-3": "-translate-y-3",
    "-2": "-translate-y-2",
    "-1": "-translate-y-1",
    "0": "-translate-y-0",
    "1": "translate-y-1",
    "2": "translate-y-2",
    "3": "translate-y-3",
}

const currentPath = Astro.url.pathname;
const isActive = currentPath === url || currentPath.startsWith(`${url}/`);
---
<div class={`box ${skewXMap[skewX]} ${skewYMap[skewY]} ${posXMap[posX]} ${posYMap[posY]} relative bg-daintree-1000 text-daintree-100 font-black text-5xl px-8 py-4 w-fit group nav-btn rounded-sm  origin-left`}>
    <a href={url} target="_self" class="label uppercase font-display tracking-wide block">
        {text}
    </a>
    <div class="bar bg-amber-500 h-3 w-full absolute left-0 right-0 bottom-0 scale-y-0 opacity-0 origin-bottom translate-x-"></div>
</div>

<script>
  import "../scripts/navButton.ts";
</script>