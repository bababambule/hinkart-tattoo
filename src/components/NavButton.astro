---
const { url, text, kanji, skewX, skewY, posX, posY} = Astro.props

const skewXMap: Record<string, string> = {
    "0": "skew-x-0",
    "3": "skew-x-3",
    "6": "skew-x-6",
    "12": "skew-x-12",
    "-3": "-skew-x-3",
    "-6": "-skew-x-6",
    "-12": "-skew-x-12",
};

const skewYMap: Record<string, string> = {
    "0": "skew-y-0",
    "3": "skew-y-3",
    "6": "skew-y-6",
    "12": "skew-y-12",
    "-3": "-skew-y-3",
    "-6": "-skew-y-6",
    "-12": "-skew-y-12",
};

const posXMap: Record<string, string> = {
    "0": "translate-x-2",
    "1": "translate-x-12",
    "2": "translate-x-24",
}

const posYMap: Record<string, string> = {
    "-3": "-translate-y-3",
    "-2": "-translate-y-2",
    "-1": "-translate-y-1",
    "0": "-translate-y-0",
    "1": "translate-y-1",
    "2": "translate-y-2",
    "3": "translate-y-3",
}

const currentPath = Astro.url.pathname;
const isActive = currentPath === url || currentPath.startsWith(`${url}/`);
---
<a href={url} target="_self" class={`box ${skewXMap[skewX]} ${skewYMap[skewY]} ${posXMap[posX]} ${posYMap[posY]} relative bg-daintree-1000 text-daintree-100 font-black text-5xl px-8 py-4 w-fit nav-btn rounded-sm  origin-left ${isActive ? 'hidden' : 'block'} cursor-pointer`}>
    <p class="label uppercase font-display tracking-wide block">
        {text}
    </p>
    <div class="bar bg-amber-500 h-3 w-full absolute left-0 right-0 bottom-0 scale-y-0 opacity-0 origin-bottom translate-x-"></div>
</a>

<div class={`${isActive ? 'block' : 'hidden'} ${skewXMap[skewX]} ${skewYMap[skewY]} ${posXMap[posX]} ${posYMap[posY]} relative bg-pink-600 text-pink-50 w-fit nav-btn rounded-sm origin-left border-daintree-1000 border-4 px-8 pb-2`}>
    <p class="stroke-text uppercase font-display tracking-wide block text-5xl relative -mt-4 mb-1" data-stroke-text={text}>{text}</p>
    <div class="flex w-full py-2 content-center gap-2">
        <div class="bg-tree-poppy-600 border-tree-poppy-1000 border-4 rounded-sm h-4 flex-1 -ml-12"></div>
        <span class="flex-none font-kanji text-xl leading-3 tracking-tighter">{kanji}</span>
        <div class="bg-tree-poppy-600 border-tree-poppy-1000 border-4 rounded-sm h-4 flex-1 -mr-12"></div>
    </div>
</div>

<script>
  import "../scripts/navButton.ts";
</script>

<style>
    .stroke-text::after {
        content: attr(data-stroke-text);
        -webkit-text-stroke: .75rem black;
        color: black;
        display:block;
        position: absolute;
        top: 2px;
        right: 2px;
        z-index: -1;
    }
</style>