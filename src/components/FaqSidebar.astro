---
import { getCollection } from 'astro:content';
import Icons from './Icons.astro';
import Accordion from './Accordion.astro';
const elements = await getCollection('generalFaq');
---

<div class="relative h-full max-w-full px-4 py-6">
	<h2
		class="absolute top-0 left-0 -translate-y-3 -rotate-6 font-display text-3xl text-daintree-900 select-none text-button-stroke-daintree-1000 [--ls-from:black] [--ls-to:black] long-shadow-xs"
		class:list={['dark:text-daintree-100']}
	>
		FAQ
	</h2>
	<div class="flex flex-col gap-2">
		{elements.map((item) => <Accordion name={item.data.group} question={item.data.question} answer={item.data.answer} />)}
	</div>
	<svg class="absolute top-0 left-0 -z-10 h-full w-full overflow-visible">
		<filter id="displacementShadow" x="-30%" y="-30%" width="160%" height="160%">
			<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="2" result="turbulence"></feTurbulence>
			<feDisplacementMap in2="turbulence" in="SourceGraphic" scale="2" xChannelSelector="R" yChannelSelector="G" result="displaced"
			></feDisplacementMap>
		</filter>
		<rect
			x="0"
			y="0"
			width="100%"
			height="100%"
			fill="var(--color-daintree-700)"
			stroke="var(--color-daintree-1000)"
			stroke-width="4"
			filter="url(#displacementShadow)"></rect>
	</svg>
</div>
