---
import NewsletterIcon from './icons/Newsletter.astro';
import Image from 'astro/components/Image.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

import comet from '../assets/icons/pepicons-print_comet.svg';
import megaphone from '../assets/icons/pepicons-print_megaphone.svg';
import clapping from '../assets/icons/pepicons-print_hands-clapping.svg';
import raise from '../assets/icons/pepicons-print_raise-hand.svg';
import stars from '../assets/icons/pepicons-print_stars.svg';
import flower from '../assets/icons/pepicons-print_flower.svg';

const newsletterBenefits = [
	{ icon: clapping, text: 'First Dibs on Tattoo Flashes' },
	{ icon: comet, text: 'Early Access Booking' },
	{ icon: raise, text: 'Guest Artists' },
	{ icon: megaphone, text: 'Studio News' },
	{ icon: stars, text: 'Exclusive Events' },
	{ icon: flower, text: 'Tips & inspirations' },
];
---

<div class="mt-12 p-2 lg:hidden">
	<div class="relative">
		<svg width="100%" height="4.5rem" class="absolute top-3 overflow-visible">
			<rect
				x="15%"
				y="0"
				width="85%"
				height="100%"
				fill="var(--color-winter-sky-600)"
				stroke-width="4px"
				stroke="var(--color-winter-sky-1000)"
				filter="url(#displacementFilter)"
				class="-skew-y-4"></rect>
		</svg>
		<div class="relative z-10 flex flex-row gap-4">
			<label for="newsletterTrigger" class="flex-1">
				<NewsletterIcon />
			</label>
			<div
				class="-rotate-2 pr-8 font-display text-daintree-200 text-stroke-width-[0.3rem] [--ls-from:black] [--ls-to:black] long-shadow-xs stroke-color-black"
			>
				<p class="text-2xl leading-7 xl:text-3xl xl:leading-4">
					Subscribe to our
					<span class="inline-block -rotate-3 font-bold text-rose-bud-cherry-300 stroke-color-rose-bud-cherry-500">ニュースレター</span>
				</p>
				<p class="text-3xl [--ls-from:black] [--ls-to:black] long-shadow-sm xl:text-7xl">Newsletter</p>
			</div>
		</div>
	</div>
	<div class="relative">
		<svg width="100%" class="absolute top-3 h-[93%] overflow-visible">
			<rect
				x="0"
				y="0"
				width="100%"
				height="100%"
				fill="var(--color-winter-sky-50)"
				stroke-width="4px"
				stroke="var(--color-winter-sky-1000)"
				filter="url(#displacementFilter)"
				class="-skew-y-2"></rect>
		</svg>
		<div class="flex flex-col gap-8 p-3 pt-6">
			<ul class="flex flex-row flex-wrap items-start gap-x-3 gap-y-4">
				{
					newsletterBenefits.map((benefit) => (
						<li class="text-md relative -skew-2 bg-winter-sky-900 py-2 pr-10 pl-3 font-bold text-winter-sky-100 even:-translate-y-1.5">
							<span class="inline-block max-w-[10ch]">{benefit.text}</span>
							<Image src={benefit.icon} alt="icon" width={40} class={'absolute -top-1 -right-2'} />
						</li>
					))
				}
			</ul>
			<NewsletterForm />
		</div>
	</div>
</div>
