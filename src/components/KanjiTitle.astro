---
interface Props {
	title: string;
	size: string;
	classes: string;
}

const { title = 'カンジ', size = 'text-3xl xl:text-7xl', classes } = Astro.props;
---

<div
	class:list={['font-kanji text-winter-sky-600 relative tracking-tighter kanji-outline z-10 -rotate-3', size, classes]}
	data-title={title}
	id="kanjiTitle"
>
	{title}
</div>

<script src="../scripts/kanjiTitle.js"></script>

<style>
	.kanji-outline {
		-webkit-text-stroke: 0.6rem var(--color-winter-sky-800);
		paint-order: stroke fill;
	}
</style>
