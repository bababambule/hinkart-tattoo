---
import BookingStep from '../components/BookingStepIndicator.astro';
import Button from '../components/Button.astro';
import MultiStep from './form/MultiStep.astro';

// Steps
import StepTerms from './form/StepTerms.astro';
import StepIdea from './form/StepIdea.astro';
import StepArtists from './form/StepArtists.astro';
import StepDate from './form/StepDate.astro';
import StepPersonal from './form/StepPersonal.astro';

interface props {
	artist: string;
}

const { artist } = Astro.props;
let stepCounter: number;
let totalSteps: number;
---

<div class="flex flex-col gap-4">
	<div class="w-full relative">
		<svg class="size-full overflow-visible absolute -z-10">
			<filter id="rough" x="-30%" y="-30%" width="160%" height="160%">
				<feTurbulence type="turbulence" baseFrequency="0.01" numOctaves="2" result="turbulence"></feTurbulence>
				<feDisplacementMap
					in2="turbulence"
					in="SourceGraphic"
					scale="2"
					xChannelSelector="R"
					yChannelSelector="G"
					result="displaced"
				></feDisplacementMap>
			</filter>
			<defs>
				<linearGradient id="gradient-1" gradientTransform="rotate(90)">
					<stop offset="55%" stop-color="var(--color-daintree-800)"></stop>
					<stop offset="55%" stop-color="var(--color-daintree-900)"></stop>
				</linearGradient>
			</defs>
			<rect
				x="0"
				y="0"
				width="100%"
				height="100%"
				fill="url(#gradient-1)"
				stroke="var(--color-daintree-1000)"
				stroke-width="4"
				filter="url(#rough)"
			></rect>
		</svg>

		<div class="font-display text-daintree-100 flex flex-col justify-center items-center pt-4">
			<div class="text-[clamp(1.5rem,6vw+1rem,2rem)] leading-none" class:list={['xl:text-6xl']}>
				Book your
			</div>

			<div
				class="text-[clamp(1.5rem,6vw+1rem,2rem)] -my-5 font-kanji text-winter-sky-600 z-10 text-button-stroke-winter-sky-900"
				class:list={['xl:text-6xl', 'xl:-my-8']}
			>
				よやく
			</div>
			<div class="text-[clamp(2rem,8vw+1rem,2.5rem)] leading-none" class:list={['xl:text-8xl']}>
				Appointment
			</div>
		</div>
		<div id="stepList" class="@container flex flex-row justify-evenly pb-2 text-daintree-100" class:list={[]}>
			<BookingStep active={true} step={1} label="Terms" kanji="りようきやく" />
			<BookingStep active={false} step={2} label="Idea" kanji="りようきやく" />
			<BookingStep active={false} step={3} label="Artist" kanji="りようきやく" />
			<BookingStep active={false} step={4} label="Date" kanji="りようきやく" />
			<BookingStep active={false} step={5} label="Personal" kanji="りようきやく" />
		</div>
	</div>
</div>

<div class="col-start-1 w-full">
	<form action="https://webhooktest.net/webhook/01a0f29d-adc8-78aa-ae75-af6145a2edd4" method="post" class="h-full">
		<div class="flex flex-col h-full">
			<div class="flex-1">
				<MultiStep name="terms" step="1" hidden="false">
					<StepTerms />
				</MultiStep>
				<MultiStep name="idea" step="2" hidden="true">
					<StepIdea />
				</MultiStep>
				<MultiStep name="artist" step="3" hidden="true">
					<StepArtists />
				</MultiStep>
				<MultiStep name="date" step="4" hidden="true">
					<StepDate />
				</MultiStep>
				<MultiStep name="personal" step="5" hidden="true">
					<StepPersonal />
				</MultiStep>

				<div class="flex flex-row justify-end py-4">
					<Button id="formContinue" href="#" label="Continue" kanji="つぎへ" icon="Map" disabled="true" />
					<Button id="formSubmit" href="" label="Book" kanji="つぎへ" icon="Letter" disabled="true" hidden="true" />
				</div>
			</div>
		</div>
	</form>
</div>

<script src="../scripts/bookingForm.ts"></script>
