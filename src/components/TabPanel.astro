---
interface props {
	slot: string;
	target: string;
	id: string;
}

const { slot, target, id } = Astro.props;
---

<div
	id={id}
	aria-labelledby={target}
	slot={slot}
	class="min-h-3/4 max-h-full mx-4 bg-daintree-800 text-daintree-100 border-4 border-t-0 border-daintree-1000 p-8 flex-1 xl:text-xl"
>
	<slot />
</div>
