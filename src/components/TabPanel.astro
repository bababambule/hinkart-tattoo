---
interface props {
	slot: string;
	target: string;
	id: string;
}

const { slot, target, id } = Astro.props;
---

<div
	id={id}
	aria-labelledby={target}
	slot={slot}
	class="mx-4 max-h-full min-h-3/4 flex-1 border-4 border-t-0 border-daintree-1000 bg-daintree-800 p-8 text-daintree-100 xl:text-xl"
>
	<slot />
</div>
