---
import Logo from './Logo.astro';
import Icons from './Icons.astro';
import FooterLink from './FooterLink.astro';
---

<footer class:list={['bg-daintree-1000 w-full text-daintree-100 uppercase text-sm z-0 pl-4 py-8 lg:bottom-6 lg:flex lg:justify-start lg:z-10']}>
	<div
		class:list={[
			'grid grid-cols-[1fr,max-content] gap-2',
			'lg:flex lg:pl-[22.5dvw] lg:pr-8 lg:rounded-tr-md lg:rounded-br-md lg:border-4 lg:min-h-12 lg:flex-row lg:gap-8 lg:pt-0',
		]}
	>
		<a href="/" target="_self" class="col-start-1 col-span-1 pl-11">
			<Logo height={80} width={null} />
			<span class="block mt-4 font-bold">Hinkart Tattoo Studio</span>
		</a>
		<a
			href="https://share.here.com/l/53.21432,6.57328,Verlengde%20Oosterstraat%202,%209711%20EN%20Groningen,%20Netherlands?z=19.65&t=normal"
			target="_blank"
			class="inline-flex items-center gap-3 footer-btn col-start-1 col-span-1"
		>
			<div class="-rotate-3 footer-btn__icon">
				<Icons icon="Map" size={32} classes={null} />
			</div>
			<span class="footer-btn__label">Verlengde Osterstraat 2, 9711 en Groningen</span>
		</a>
		<a href="mailto:info@hinkart.nl" class="inline-flex items-center gap-3 footer-btn order-2 col-start-1 col-span-1" class:list={['lg:order-3']}>
			<div class="-rotate-3 footer-btn__icon">
				<Icons icon="Letter" size={32} />
			</div>
			<span class="footer-btn__label">info@hinkart.nl</span>
		</a>
		<div class="pr-2 col-start-2 col-span-1 row-start-1 row-span-3 flex flex-wrap gap-4 justify-end order-3 mt-6 lg:order-2 lg:mt-0">
			<FooterLink url="https://www.instagram.com/hinkarttattoostudio/" label="Instagram" />
			<FooterLink url="https://www.tiktok.com/@hinkarttattoostudio" label="Tiktok" />
			<FooterLink url="#" label="Legal Notice" />
			<FooterLink url="#" label="Data Privacy" />
		</div>
	</div>
</footer>

<script>
	import '../scripts/footer.ts';
</script>

<style is:inline>
	.clip:first-of-type {
		clip-path: polygon(5% 5%, 100% 0%, 95% 95%, 0% 100%);
		transform: rotate(-3deg);
	}
	.clip:nth-child(2) {
		clip-path: polygon(0% 0%, 95% 5%, 100% 100%, 5% 95%);
		transform: rotate(3deg);
	}
	.clip:nth-child(3) {
		clip-path: polygon(0% 5%, 100% 5%, 95% 95%, 0% 95%);
		transform: rotate(-3deg);
	}
	.clip:last-of-type {
		clip-path: polygon(5% 0%, 100% 0%, 95% 95%, 0% 100%);
		transform: rotate(3deg);
	}
</style>
