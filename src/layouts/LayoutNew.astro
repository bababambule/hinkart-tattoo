---
import Header from '../components/Header.astro';
import Main from '../components/Main.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class:list="xl:h-full">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<meta name="generator" content={Astro.generator} />
		<title>Hinkart Tattoo Studio</title>
	</head>
	<body class:list={['max-w-dvw', 'bg-daintree-100 dark:bg-daintree-800', 'xl:overflow-clip', 'xl:max-h-dvh']}>
		<div class="min-h-screen flex flex-col mb-64">
			<Header />
			<Main>
				<slot />
			</Main>
		</div>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
