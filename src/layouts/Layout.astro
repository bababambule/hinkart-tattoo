---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import Reviews from '../components/Reviews.astro';
import SvgFilter from '../components/SvgFilter.astro';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en" class:list="xl:h-full">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Hinkart Tattoo Studio</title>
		<ClientRouter />
	</head>
	<body
		class="bg-daintree-900 flex flex-col min-h-dvh
			lg:flex-row lg:max-w-dvw lg:overflow-clip lg:max-h-dvh"
	>
		<Header />
		<main
			transition:animate="fade"
			class="flex-1 relative z-10 px-2 pt-12
				lg:pt-8 lg:pr-12 lg:pb-8 lg:pl-[10dvw] lg:w-full lg:h-screen"
		>
			<slot />
		</main>
		<Newsletter />
		<Reviews />
		<Footer />
		<SvgFilter />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
