---
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class:list="xl:h-full">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<meta name="generator" content={Astro.generator} />
		<title>Hinkart Tattoo Studio</title>
	</head>
	<body class="max-w-dvw" class:list={['bg-daintree-100', 'dark:bg-daintree-800', 'xl:overflow-clip', 'xl:max-h-dvh']}>
		<!-- <Sidebar /> -->
		<main
			class="pt-4 pb-8 px-3 min-h-[110dvh] bg-daintree-100 relative z-10 mb-64"
			class:list={['lg:mb-0', 'xl:pt-8', 'xl:px-0', 'xl:h-screen', 'xl:pl-[10dvw]', 'xl:pb-24', 'xl:pr-12', 'dark:bg-daintree-800', 'lg:pb-0']}
		>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
