---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Main from '../components/layout/Main.astro';
import Footer from '../components/layout/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import Reviews from '../components/Reviews.astro';
import SvgFilter from '../components/SvgFilter.astro';
import HalftoneBackground from '../components/layout/HalftoneBackground.astro';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en" class:list="xl:h-full">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Hinkart Tattoo Studio</title>
		<ClientRouter />
	</head>
	<body class="flex min-h-dvh flex-col bg-daintree-900 lg:max-h-dvh lg:max-w-dvw lg:flex-row lg:overflow-clip">
		<HalftoneBackground />
		<Header />
		<Main><slot /></Main>
		<!-- <Newsletter />
		<Reviews /> -->
		<Footer />
		<SvgFilter />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
