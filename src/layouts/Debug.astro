---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<meta name="generator" content={Astro.generator} />
		<title>Hinkart Tattoo Studio</title>
	</head>
	<body class="bg-daintree-800 max-w-dvw xl:max-h-dvh xl:overflow-clip">
		<main class="xl:h-screen xl:pl-[10dvw] pt-8 pb-24 xl:pr-12">
			<slot />
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
